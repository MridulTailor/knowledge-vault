# Database
DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_vault"

# JWT Authentication
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-chars"

# App Base URL (Important for production redirect URI calculation)
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_URL="http://localhost:3000"

# OAuth 2.0 / OpenID Connect (OIDC) - Google
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origin: https://your-domain.com
# Authorized redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
